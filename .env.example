# Render: Environment > Add from .env. Replace placeholders before importing.
# This example contains no credentials. .env.render is private and ignored by Git.
SPRING_PROFILES_ACTIVE=postgres
ACADEMIC_DB_URL=jdbc:postgresql://YOUR_NEON_HOST/YOUR_DATABASE?sslmode=require
ACADEMIC_DB_USERNAME=YOUR_NEON_USERNAME
ACADEMIC_DB_PASSWORD=YOUR_NEON_PASSWORD
JWT_SECRET=YOUR_RANDOM_BASE64_KEY_OF_AT_LEAST_32_BYTES
JWT_EXPIRATION_MS=3600000
AI_API_KEY=YOUR_GROQ_API_KEY
AI_MODEL=openai/gpt-oss-20b
AI_TIMEOUT=20s
# Replace with the exact frontend origin when Angular is deployed (no trailing /).
CORS_ORIGIN=http://localhost:4200
# Render provides PORT; no need to set it manually.

# Per-instance, fixed-window request limits (no database migration).
LOGIN_ACCOUNT_LIMIT=10
LOGIN_IP_LIMIT=100
LOGIN_LIMIT_WINDOW=15m
REGISTER_ACCOUNT_LIMIT=5
REGISTER_IP_LIMIT=30
REGISTER_LIMIT_WINDOW=1h
AI_USER_QUOTA=20
AI_QUOTA_WINDOW=1h
AI_MAX_CONCURRENT=2
AI_MAX_CONCURRENT_PER_USER=1
RATE_LIMIT_MAX_KEYS=10000
# Empty means socket IP only. Set ONLY verified proxy IPs/CIDRs you control/trust.
TRUSTED_PROXY_CIDRS=
